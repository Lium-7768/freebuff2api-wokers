{
  "name": "freebuff2api-container",
  "version": "1.9.0",
  "type": "module",
  "private": true,
  "description": "Freebuff OpenAI-compatible adapter for a self-hosted Node/VPS runtime",
  "scripts": {
    "start": "node server.js",
    "test": "node --test --test-concurrency=1 test/worker.test.mjs test/server-shutdown.test.mjs",
    "test:e2e": "node test/e2e-local.mjs",
    "audit:protocol": "node scripts/audit/protocol-audit.mjs && node scripts/audit/responses-history-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
